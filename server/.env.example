# DailyTask API — variables de entorno de ejemplo.

# development | production | test
NODE_ENV=development

# Dirección y puerto de escucha. En producción, detrás del proxy.
HOST=127.0.0.1
PORT=3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# IPs o rangos CIDR de los proxies de confianza, separados por comas.
# Vacío = no se confía en X-Forwarded-*. No se admite "true".
TRUST_PROXY=

# Carpeta dist/ del frontend compilado. Si se define, Fastify sirve también la aplicación
# React (mismo origen que /api). Vacío = solo API (desarrollo con Vite en :5173).
# Producción: ruta absoluta al dist/ compilado.
STATIC_DIR=

# Límites de protección (valores por defecto mostrados).
BODY_LIMIT_BYTES=16384
REQUEST_TIMEOUT_MS=15000
SHUTDOWN_TIMEOUT_MS=10000

# --- MySQL ---
# Desarrollo: contenedor local de `npm run db:dev up` (valores solo de desarrollo).
# Producción: DB_SOCKET_PATH (ruta real de @@socket) o DB_HOST/DB_PORT del servidor MySQL en lugar de los valores locales,
# y DB_PASSWORD_FILE (fichero 0400 fuera del repo) en lugar de DB_PASSWORD.
DB_HOST=127.0.0.1
DB_PORT=3307
# DB_SOCKET_PATH=
DB_NAME=dailytask_dev
DB_USER=dailytask_app
DB_PASSWORD=dailytask-dev-app
# DB_PASSWORD_FILE=
DB_POOL_SIZE=5
DB_CONNECT_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=3000

# Cuenta con permiso CREATE, usada SOLO por `npm run db:init` (no por la API).
DB_INIT_USER=dailytask_migrator
DB_INIT_PASSWORD=dailytask-dev-migrator
# DB_INIT_PASSWORD_FILE=

# --- Autenticación y sesiones ---
# Orígenes permitidos para peticiones que modifican datos (separados por comas).
# Vacío fuera de producción = http://localhost:5173,http://127.0.0.1:5173.
# Producción: obligatorio y con https (p. ej. https://dailytask.ejemplo).
PUBLIC_ORIGIN=
# Atributo Secure de la cookie dt_session. Por defecto true en producción (obligatorio allí).
COOKIE_SECURE=false
SESSION_IDLE_TTL_HOURS=168
SESSION_ABSOLUTE_TTL_HOURS=720
SESSION_CLEANUP_INTERVAL_MINUTES=60
# Argon2id (mínimos OWASP; no se admiten valores menores).
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# --- Límites de peticiones (por minuto) ---
RATE_LIMIT_GLOBAL_PER_MIN=300
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_LOGIN_USER_PER_MIN=5
RATE_LIMIT_REGISTER_PER_MIN=5

# --- Tareas ---
MAX_TASKS_PER_USER=1000
