# DailyTask API — variables de entorno de ejemplo.

# development | production | test
NODE_ENV=development

# Dirección y puerto de escucha. En producción, detrás del proxy.
HOST=127.0.0.1
PORT=3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# IPs o rangos CIDR de los proxies de confianza, separados por comas.
# Vacío = no se confía en X-Forwarded-*. No se admite "true".
TRUST_PROXY=

# Límites de protección (valores por defecto mostrados).
BODY_LIMIT_BYTES=16384
REQUEST_TIMEOUT_MS=15000
SHUTDOWN_TIMEOUT_MS=10000

# --- MySQL ---
# Desarrollo: contenedor local de `npm run db:dev up` (valores solo de desarrollo).
# Producción (NixOS): DB_SOCKET_PATH=/run/mysqld/mysqld.sock en lugar de DB_HOST/DB_PORT,
# y DB_PASSWORD_FILE (fichero 0400 fuera del repo) en lugar de DB_PASSWORD.
DB_HOST=127.0.0.1
DB_PORT=3307
# DB_SOCKET_PATH=
DB_NAME=dailytask_dev
DB_USER=dailytask_app
DB_PASSWORD=dailytask-dev-app
# DB_PASSWORD_FILE=
DB_POOL_SIZE=5
DB_CONNECT_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=3000

# Cuenta con permiso CREATE, usada SOLO por `npm run db:init` (no por la API).
DB_INIT_USER=dailytask_migrator
DB_INIT_PASSWORD=dailytask-dev-migrator
# DB_INIT_PASSWORD_FILE=

# --- Fases posteriores (aún no se leen) ---
# PUBLIC_ORIGIN=http://localhost:5173
# COOKIE_SECURE=false
# SESSION_IDLE_TTL_HOURS=168
# SESSION_ABSOLUTE_TTL_HOURS=720
