{
    "name": "dailytask-server",
    "private": true,
    "version": "0.1.0",
    "description": "API REST de DailyTask (Fastify + TypeScript).",
    "type": "module",
    "engines": {
        "node": ">=22.18.0"
    },
    "scripts": {
        "dev": "node --watch --env-file-if-exists=.env src/server.ts",
        "start": "node dist/server.js",
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit",
        "db:init": "node --env-file-if-exists=.env src/db/init.ts",
        "db:init:prod": "node dist/db/init.js",
        "db:dev": "bash dev/mysql.sh",
        "test": "node --test --test-reporter=spec \"test/*.test.ts\"",
        "test:db": "node --test --test-reporter=spec --test-concurrency=1 \"test/db/*.test.ts\"",
        "test:all": "npm test && npm run test:db"
    },
    "dependencies": {
        "fastify": "5.12.8",
        "mysql2": "3.24.6"
    },
    "devDependencies": {
        "@types/node": "24.19.2",
        "typescript": "5.9.3"
    }
}
